{
  "version": 1,
  "sdk_version": "3.0.4",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://cxdhtsvetxcqtedwnbbt.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "scrap",
      "version": "0.1.0",
      "title": "Scrap"
    },
    "tools": [
      {
        "name": "list_documents",
        "title": "List notes and pages",
        "description": "List the signed-in user's notes and pages (not in Trash), newest first, optionally filtered by kind or search text.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "kind": {
              "description": "Only notes or only pages.",
              "type": "string",
              "enum": [
                "note",
                "page"
              ]
            },
            "query": {
              "description": "Text to search in titles and content.",
              "type": "string",
              "maxLength": 200
            },
            "limit": {
              "description": "Max results (default 25).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_document",
        "title": "Read a note or page",
        "description": "Get the full title and text of one of the user's notes or pages by id.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Document id from list_documents."
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "create_document",
        "title": "Create a note or page",
        "description": "Create a new note or page for the signed-in user with a title and plain-text body (blank lines separate paragraphs).",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "note",
                "page"
              ],
              "description": "Create a short note or a long-form page."
            },
            "title": {
              "type": "string",
              "maxLength": 300,
              "description": "Document title."
            },
            "text": {
              "type": "string",
              "maxLength": 100000,
              "description": "Body text."
            }
          },
          "required": [
            "kind",
            "title",
            "text"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
